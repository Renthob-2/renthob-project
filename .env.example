# Browser-safe Supabase project settings. Configure these in the hosting dashboard.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public production origin used in confirmation, password-reset, canonical, and share links.
VITE_SITE_URL=https://renthob.com

# Optional. Leave unset unless the og-property edge function has been deployed.
# VITE_OG_SHARE_BASE_URL=https://your-project.supabase.co/functions/v1/og-property
